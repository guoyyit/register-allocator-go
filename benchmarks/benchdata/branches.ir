; Loop-backed control flow with loop-carried values stored in shared memory
; and register values live across nested conditional merges.
func main
entry:
	%1 = const 4
	%2 = const 0
	%3 = const 20
	store 0, %2
	store 1, %3
	br head
head:
	%4 = load 0
	%5 = add %4, %1
	store 0, %5
	%6 = load 1
	%7 = sub %6, %1
	store 1, %7
	%8 = cmplt %2, %7
	brcond %8, work, done
work:
	%9 = cmplt %6, %3
	brcond %9, warm, cold
warm:
	%10 = add %5, %1
	store 2, %10
	br head
cold:
	%11 = sub %5, %1
	store 2, %11
	br head
done:
	%12 = load 0
	ret %12
