// cross_call: many values stay live across a function call.
func identity(v0):
  entry:
    ret v0

func main(v0):
  entry:
    v1 = add v0, v0
    v2 = add v1, v1
    v3 = add v2, v2
    v4 = add v3, v3
    v5 = add v4, v4
    v6 = add v5, v5
    v7 = identity(v0)
    v8 = add v7, v1
    v9 = add v8, v2
    v10 = add v9, v3
    v11 = add v10, v4
    v12 = add v11, v5
    v13 = add v12, v6
    ret v13
