// high_pressure: straight-line code keeping many values live at once.
// v0..v19 are all live when v20 is formed, then they are summed.
func main():
  entry:
    v0 = 0
    v1 = 1
    v2 = 2
    v3 = 3
    v4 = 4
    v5 = 5
    v6 = 6
    v7 = 7
    v8 = 8
    v9 = 9
    v10 = 10
    v11 = 11
    v12 = 12
    v13 = 13
    v14 = 14
    v15 = 15
    v16 = 16
    v17 = 17
    v18 = 18
    v19 = 19
    v20 = 20
    v30 = add v0, v1
    v31 = add v30, v2
    v32 = add v31, v3
    v33 = add v32, v4
    v34 = add v33, v5
    v35 = add v34, v6
    v36 = add v35, v7
    v37 = add v36, v8
    v38 = add v37, v9
    v39 = add v38, v10
    v40 = add v39, v11
    v41 = add v40, v12
    v42 = add v41, v13
    v43 = add v42, v14
    v44 = add v43, v15
    v45 = add v44, v16
    v46 = add v45, v17
    v47 = add v46, v18
    v48 = add v47, v19
    v49 = add v48, v20
    v50 = 0
    store v49, [v50]
    ret v49
